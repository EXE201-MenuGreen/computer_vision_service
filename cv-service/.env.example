
# --- Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1

# --- Model weights ---
FOOD_DETECTION_WEIGHTS=weights/yolov8_food.pt
FOOD_CLASSIFY_WEIGHTS=weights/efficientnet_food.pt
DEPTH_MODEL_NAME=depth-anything/Depth-Anything-V2-Small-hf
DEVICE=cpu           # change to "cuda" on GPU server

# --- Image validation ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp"]

# --- Nutrition API ---
USDA_API_KEY=DEMO_KEY
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# --- Redis (for async job queue) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
API_SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=["http://localhost","http://c-sharp-backend:5000"]

# --- Logging ---
LOG_LEVEL=INFO

# --- Pipeline stage selection ---
PIPELINE_DETECTOR=yolov8
PIPELINE_CLASSIFIER=efficientnet_b4
PIPELINE_DEPTH=depth_anything_v2
PIPELINE_POSTPROCESSOR=default
