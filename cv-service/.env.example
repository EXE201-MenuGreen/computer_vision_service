# --- Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1

# --- Image validation ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- Nutrition API ---
USDA_API_KEY=DEMO_KEY
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
NUTRITION_ENRICHMENT_ENABLED=true

# --- AI Provider ---
AI_PROVIDER=gemini             # gemini | remote_api
AI_API_BASE_URL=http://ai-api-server
AI_API_KEY=your-bearer-token

# --- Gemini API ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.9
GEMINI_TOP_P=0.95
GEMINI_MIN_DISH_SUGGESTIONS=3
GEMINI_MAX_DISH_SUGGESTIONS=5

# --- Redis (for async job queue) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
API_SECRET_KEY=
ADMIN_API_KEY=change-me-admin-secret
ALLOWED_ORIGINS=http://localhost,http://c-sharp-backend:5000

# --- Logging ---
LOG_LEVEL=INFO
